# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=GuidaOspiti
# URL pubblico (in produzione: https://tuodominio.it). Usato per link e QR code.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Prezzo di pubblicazione in centesimi (2900 = 29 €)
NEXT_PUBLIC_PREZZO_GUIDA_CENTESIMI=2900

# --- Supabase (Project Settings → API) ---------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx   # oppure la vecchia "anon key"
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx                   # SOLO lato server, mai esporla

# --- Claude API (fase 3) ------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-xxx

# --- Stripe (fase 4) ----------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Pagine legali -------------------------------------------------------------
NEXT_PUBLIC_TITOLARE_NOME=
NEXT_PUBLIC_TITOLARE_SEDE=
NEXT_PUBLIC_TITOLARE_PIVA=
NEXT_PUBLIC_EMAIL_CONTATTO=
